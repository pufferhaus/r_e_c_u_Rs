[Unit]
Description=r_e_c_u_Rs video sampler
After=local-fs.target
DefaultDependencies=no

[Service]
Type=simple
User=imi
WorkingDirectory=/home/imi/r_e_c_u_rs
# Pin the display output to one port so it never changes across reboots, and
# the video orientation for this panel/converter. RECUR_VIDEO_ORIENT accepts
# normal|flipv|fliph|rot180 (default normal); RECUR_DRM_CONNECTOR forces the
# DRM connector by name (e.g. HDMI-A-1, the port nearest the USB-C jack).
Environment=RECUR_DRM_CONNECTOR=HDMI-A-1
Environment=RECUR_VIDEO_ORIENT=normal
# Privileged pre-start (the `+` prefix runs as root even though User=imi):
#  1. Unbind the framebuffer console (fbcon) so the kernel console / getty login
#     prompt stops drawing on the SPI LCD (fb0). Without this, fbcon and the app
#     fight over the same framebuffer — the login prompt overwrites the grid and
#     the contention shows as flicker. The app then owns the LCD exclusively.
#  2. Force the pinned HDMI connector "on". Cheap monitors / capture cards / KVMs
#     and HDMI→composite converters that don't assert hot-plug or provide EDID
#     report "disconnected" with 0 modes, so KMS gives the app no modes; forcing
#     "on" exposes standard fallback modes. Only the pinned port is forced so the
#     unused port can't masquerade as connected and steal selection.
ExecStartPre=+/bin/sh -c 'for d in /sys/class/vtconsole/vtcon*; do grep -q "frame buffer device" "$d/name" && echo 0 > "$d/bind"; done; echo on > /sys/class/drm/card1-HDMI-A-1/status 2>/dev/null; true'
ExecStart=/home/imi/r_e_c_u_rs/r_e_c_u_rs
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
