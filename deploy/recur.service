[Unit]
Description=r_e_c_u_Rs video sampler
After=local-fs.target
DefaultDependencies=no

[Service]
Type=simple
User=imi
WorkingDirectory=/home/imi/r_e_c_u_rs
# Privileged pre-start (the `+` prefix runs as root even though User=imi):
#  1. Unbind the framebuffer console (fbcon) so the kernel console / getty login
#     prompt stops drawing on the SPI LCD (fb0). Without this, fbcon and the app
#     fight over the same framebuffer — the login prompt overwrites the grid and
#     the contention shows as flicker. The app then owns the LCD exclusively.
#  2. Force the HDMI connector "on". Cheap monitors / capture cards / KVMs that
#     don't assert hot-plug or provide EDID report "disconnected" with 0 modes,
#     so KMS gives the app no modes; forcing "on" exposes standard fallback modes.
ExecStartPre=+/bin/sh -c 'for d in /sys/class/vtconsole/vtcon*; do grep -q "frame buffer device" "$d/name" && echo 0 > "$d/bind"; done; echo on > /sys/class/drm/card1-HDMI-A-1/status 2>/dev/null; echo on > /sys/class/drm/card1-HDMI-A-2/status 2>/dev/null; true'
ExecStart=/home/imi/r_e_c_u_rs/r_e_c_u_rs
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
